name = WeChat-Pro

# WeChat-Pro 1.0.0 — verified 2026-07-06
# Format: 0=IPv4 CIDR, 1=IPv6 CIDR, 2=domain suffix/exact, 3=keyword

# Core
2, wechat.com
2, weixin.com
2, weixin.qq.com
2, wx.qq.com

# Authentication
2, apd-pcdnwxlogin.teg.tencent-cloud.net
2, weixinbridge.com

# Messaging
2, servicewechat.com

# Media CDN
2, wx.gtimg.com
2, wxapp.tc.qq.com
2, vweixinf.tc.qq.com
2, vweixinthumb.tc.qq.com

# Avatar
2, mmbiz.qpic.cn
2, mmbiz.qlogo.cn
2, wx.qlogo.cn
2, thirdwx.qlogo.cn

# Official Account
2, weixin110.qq.com

# Mini Program
2, wxs.qq.com

# Finder
2, finder.video.qq.com

# Voice
# Uses Core, Messaging, Media CDN, IPv4, and IPv6 rules above/below.

# Video
# Uses Core, Messaging, Media CDN, Finder, IPv4, and IPv6 rules.

# WeChat Pay
2, wechatpay.cn
2, wx.tenpay.com

# WeCom
# Covered by weixin.qq.com (including work/wwcdn/qyapi children).

# Push
# Tencent-side push is covered by Core and Messaging.

# Apple Push
# APNs is shared Apple infrastructure. Anywhere cannot match ports, so the
# narrower Apple-documented APNs ranges are included instead of 17.0.0.0/8.

# International
# wechat.com covers international login/help/web; servicewechat.com and the
# tc.qq.com hosts above cover verified overseas-facing synchronization/media.

# Tencent Cloud
# apd-pcdnwxlogin.teg.tencent-cloud.net is an exact login acceleration host.

