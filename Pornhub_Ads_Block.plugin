#!name=Pornhub 去广告（Loon）
#!desc=QX rewrite_local 转 Loon Script 本地规则
#!author=ddgksf2013 (converted)
#!update-url=

[Script]
# 1) 拦截广告接口（等价：url reject-dict）
http-response ^https?:\/\/(cn|www)\.pornhub\.com\/_xa\/ads reject-dict

# 2) 主页面/接口注入去广告脚本（等价：url script-response-body）
http-response ^https?:\/\/(cn|www)\.pornhub\.com\/(?!(.*(api|login|cdn-cgi|verify|auth|captch|(\.(js|css|jpg|jpeg|png|webp|gif|zip|woff|woff2|m3u8|mp4|mov|m4v|avi|mkv|flv|rmvb|wmv|rm|asf|asx|mp3|json|ico|otf|ttf))))) script-path=https://raw.githubusercontent.com/eaglexxxm/mo/refs/heads/r/pornhub.ad.js, requires-body=true, timeout=30, tag=Pornhub去广告

[MITM]
hostname = cn.pornhub.com, www.pornhub.com