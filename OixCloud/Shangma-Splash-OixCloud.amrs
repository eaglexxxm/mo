# 上马开屏去广告 — OixCloud / Anywhere 原生格式
# Based on the user-provided HAR captured on 2026-10-17.
# Edits only the observed splash image and link; retains the JSON envelope.
# No remote script, no parameters and no routing rejects. Device test pending.
name = 上马开屏去广告
hostname = api.shang-ma.com
icon-light = 
icon-dark = 

[Rule]
1,5,^https://api\.shang-ma\.com/app/basic/banner/splashList(?:\?.*)?$,replace,$.data.splashImageUrl,""""""
1,5,^https://api\.shang-ma\.com/app/basic/banner/splashList(?:\?.*)?$,replace,$.data.splashImageLink,""""""
