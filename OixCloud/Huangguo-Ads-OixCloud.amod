# 黄果短剧广告清理 · Anywhere 原生模块
#!category=Ad Block by ai
# 网页主机按原名单保留：bmikbxhi.cc、2a52.bmikbxhi.cc、thu.h2na6qa39.cc。
# 这次另外加上 App 接口 vlnkjpnac.cc、api6.vlnkjpnac.cc、qvymeufe.cc。
# 网页去掉 SSP 挂载和空位。App 只清广告位，含首集片头。剧集、封面和播放保留。
# 网页壳 cocoaview.cc 追加主机名。播放开关仍关，系统配置里的广告素材一并清空。
# 选择 Anywhere（原生）导入。停用上一份后再导入。
[Module]
name = 黄果短剧广告清理
category = Ad Block by ai
description = 修改时间 2026-11-17 14:08。Ad Block by ai。去掉网页横幅和播放浮层，以及 App 开屏、弹窗、横幅、片库图标、剧场插播、首集片头、网页壳开屏倒计时、居中弹窗、悬浮、播放倒计时、暂停广告和底部推广条。剧集、封面和播放保留。
icon-light = 
icon-dark = 

[MITM]
name = 黄果短剧广告过滤
hostname = bmikbxhi.cc, 2a52.bmikbxhi.cc, thu.h2na6qa39.cc, vlnkjpnac.cc, api6.vlnkjpnac.cc, qvymeufe.cc, cocoaview.cc

1,100,^https://(?:(?:[a-z0-9-]+\.)?bmikbxhi\.cc|thu\.h2na6qa39\.cc)/(?!static/|api/|assets/)[^?#.]*?(?:\?[^#]*)?$,
1,100,^https://(?:(?:[a-z0-9-]+\.)?bmikbxhi\.cc|thu\.h2na6qa39\.cc)/static/web/js/modules/preroll-ad\.js(?:\?.*)?$,
1,100,^https://(?:[a-z0-9-]+\.)?(?:vlnkjpnac|qvymeufe)\.cc/api/v1/(?:app/config|content/short-drama/feed-ads|content/short-drama/mine/banner|content/library/discovery/construct|content/short-drama/theater/discovery-config|content/short-drama/theater/config|content/short-drama/theater/discovery|content/videos/episode-detail|content/videos/detail)(?:\?[^#]*)?$,
1,100,^https://cocoaview\.cc/api/ad/policy(?:\?[^#]*)?$,
