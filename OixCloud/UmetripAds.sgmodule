# Loon整接口拒绝与首页404未启用：由现有脚本按rpid精细清理，保留首页。
[Map Local]
^https:\/\/oss\.umetrip\.com\/fs\/advert\/ data-type=base64 data="R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" status-code=200 header="Content-Type:image/gif"

[Script]
umetrip.ads = type=http-response, pattern=^https?:\/\/(?:114\.115\.217\.129|(?:sns|appmsg|home|umehome|opactivity|activity|umerp|flightstatus|umeflightstatus|startup|umestartup|user|umeuser|event)\.umetrip\.com)\/gateway\/api\/umetrip\/native(?:\?.*)?$, script-path=https://raw.githubusercontent.com/eaglexxxm/mo/refs/heads/r/OixCloud/js/umetrip.js?v=20261005-3, requires-body=true, binary-body-mode=true, timeout=60

[MITM]
hostname = %APPEND% sns.umetrip.com,appmsg.umetrip.com,home.umetrip.com,umehome.umetrip.com,opactivity.umetrip.com,activity.umetrip.com,umerp.umetrip.com,flightstatus.umetrip.com,umeflightstatus.umetrip.com,startup.umetrip.com,umestartup.umetrip.com,user.umetrip.com,umeuser.umetrip.com,event.umetrip.com,oss.umetrip.com,114.115.217.129
