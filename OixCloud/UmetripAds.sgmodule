#!name=UmetripAds
#!desc=航旅纵横去广告；配套umetrip.js为用户提供脚本的Surge二进制接口适配版。
#!category=去广告
#!icon=https://raw.githubusercontent.com/Toperlock/Quantumult/main/icon/Doraemon/Doraemon-1011.png
#!date=2026-10-05

[Map Local]
^https:\/\/oss\.umetrip\.com\/fs\/advert\/ data-type=base64 data="R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" status-code=200 header="Content-Type:image/gif"

[Script]
umetrip.ads = type=http-response, pattern=^https:\/\/(?:sns|appmsg|home|umehome|opactivity|activity|umerp|flightstatus|umeflightstatus|startup|umestartup|user|umeuser|event)\.umetrip\.com\/gateway\/api\/umetrip\/native(?:\?.*)?$, script-path=https://raw.githubusercontent.com/eaglexxxm/mo/refs/heads/r/OixCloud/js/umetrip.js, requires-body=true, binary-body-mode=true, timeout=60

[MITM]
hostname = %APPEND% sns.umetrip.com,appmsg.umetrip.com,home.umetrip.com,umehome.umetrip.com,opactivity.umetrip.com,activity.umetrip.com,umerp.umetrip.com,flightstatus.umetrip.com,umeflightstatus.umetrip.com,startup.umetrip.com,umestartup.umetrip.com,user.umetrip.com,umeuser.umetrip.com,event.umetrip.com,oss.umetrip.com
