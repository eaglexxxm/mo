# 51吃瓜广告过滤 v9 · OixCloud Anywhere 原生 .amod
# 网页：保留 v8 首页/分类/文章页规则。
# App：签名 API 清理广告条目，Flutter 代码清理旧开屏缓存、广告字段和倒计时。
# 导入时选择 Anywhere（原生）；停用旧版 51吃瓜模块。
[Module]
name = 51吃瓜广告过滤 v9（网页＋App）
description = 网页广告清理；App 开屏、弹窗、浮窗及列表广告记录清理。
icon-light = 
icon-dark = 

[MITM]
name = 51吃瓜广告过滤 v9（网页＋App）
