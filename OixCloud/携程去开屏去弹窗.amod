# 携程去开屏去弹窗 · OixCloud Anywhere 原生 .amod
# 开屏和弹窗仍从 tripAds 里挑掉。公开规则把整段响应清空，8.47 以后会丢图片，这里不这么做。
# 另外拦掉墨鱼和奶思都在用的开屏统计图。导入时选择 Anywhere（原生）。
[Module]
name = 携程去开屏去弹窗
description = 修改时间 2026-10-29 08:58。只去掉携程开屏、弹窗和开屏统计，信息流和其他请求不动。
icon-light = 
icon-dark = 

[MITM]
name = 携程去开屏去弹窗
hostname = m.ctrip.com, ma-adx.ctrip.com
# 广告接口以明文回来，再去掉开屏和弹窗。
0,2,^https://m\.ctrip\.com/restapi/soa2/\d+/(?:(?:json|scjson)/)?tripAds(?:\.json)?(?:\?.*)?$,Accept-Encoding
1,100,^https://m\.ctrip\.com/restapi/soa2/\d+/(?:(?:json|scjson)/)?tripAds(?:\.json)?(?:\?.*)?$,
# 开屏统计图，墨鱼 StartUpAds 和奶思携程模块都是直接丢掉。
0,0,^https://ma-adx\.ctrip\.com/_ma\.gif(?:\?.*)?$,3
