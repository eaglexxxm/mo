# 51吃瓜 App 广告规则 v7：清理签名 API 中的广告配置，并流式处理大型 Flutter 页面脚本。
# 与 51cg1.com 网页模块分开使用；请停用旧版 51吃瓜合并模块和旧 API Override 规则集。
name = 51吃瓜 App 广告过滤 v7
hostname = p24.airdfpchm.cc, bpi3.ofqrumpqf.cc, bpi3.hkclrsgux.cc, bpi4.hkjehzjhf.cc, bpi4.yrntnqkaq.cc, pic.sugfew.cn
icon-light = 
icon-dark = 
# 大型 bundle 使用 stream-script；移除请求压缩协商以保证帧内容可匹配。
0,2,^https://p24\.airdfpchm\.cc/main\.dart\.js(?:\?.*)?$,Accept-Encoding
1,101,^https://p24\.airdfpchm\.cc/main\.dart\.js(?:\?.*)?$,
# 已观察到的签名 API，清空开屏、弹窗、浮窗和列表广告数据。
1,100,^https://(?:p24\.airdfpchm\.cc|bpi[0-9]+\.[a-z0-9-]+\.cc)/api\.php/api/(?:home/config|contents/list_contents|videos/list_contents)(?:\?.*)?$,
