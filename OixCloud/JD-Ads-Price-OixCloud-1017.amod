# 京东去广告与商品详情页历史比价；比价活动规则已包含，按客户端开关启用。
# 原生 .amod：导入时选择 Anywhere（原生），不要使用 Surge 模式。
# 来源：用户提供比价模块与 Expanded CDN 1017；源广告脚本日期2025-05-19。
# 作者：RuCu6、Maasea、fmz200、luoxx、sooyaaabo、wf021325、mw418、githubdulong。
# 2026-10-17 整合；价格查询失败保留原网页，红底本地品牌启动画面可能保留。
[Module]
name = 京东去广告与比价 1017
description = Expanded CDN去广告＋商品详情页历史价格表；首次请打开慢慢买App的“我的”获取凭据。
icon-light = 
icon-dark = 

[Routing]
name = 京东广告素材域名
routing = 2
# 原生路由无精确DOMAIN类型；此处按域名后缀拒绝，也覆盖这两个广告主机的子域名。
2, ads-img-x.jd.com
2, ads-video-x.jd.com
# 附件另带的14条SDK/HTTPDNS/业务域名拒绝不随比价开启，沿用Expanded的停用选择。

[MITM]
name = 京东接口去广告
hostname = api.m.jd.com
0,100,(?i)(?:(?:^https?:\/\/api\.m\.jd\.com\/\?(?:[^&]*&)*loginType=11)|(?:^https?:\/\/api\.m\.jd\.com\/client\.action\?(?:[^&]*&)*functionId=getWidgetV1052)|(?:^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^&]*&)*functionId=(?:cartCouponRecommendGoods|intelligentRecommendSku|obtainGrowingInfo|recommendShop|searchBoxWord|stationPullService|uniformRecommend))),
1,5,(?i)^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^&]*&)*functionId=basicConfig,replace,$.data.JDMessage.socketmonitor.isSocketEstablishedAhead,0
1,5,(?i)^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^&]*&)*functionId=basicConfig,replace,$.data.JDMessage.socketmonitor.isSocketReport,0
1,5,(?i)^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^&]*&)*functionId=basicConfig,replace,$.data.JDHttpToolKit.httpdns.httpdns,0
1,5,(?i)^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^&]*&)*functionId=cart,delete,$.cartLocationMap.loc_emptyCartFloor2
1,5,(?i)^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^&]*&)*functionId=cart,delete,$.emptyCartRecommendFloor
1,4,(?i)^https?:\/\/api\.m\.jd\.com\/client\.action\?(?:[^&]*&)*functionId=lite_advertising,jdLiteAdvertisingVO,sooyaaabo
1,100,^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^&]*&)*functionId=(?:deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome)(?:&|$),

[MITM]
name = 京东竖屏推广素材
# 原生hostname使用后缀，不支持m*；实际处理仍由下方数字主机＋固定路径前缀限定。
hostname = 360buyimg.com
0,100,(?i)^https?:\/\/m[0-9]*\.360buyimg\.com\/mobilecms\/s1125x2436_jfs,

[MITM]
name = 京东HTTP诊断上报
hostname = jddebug.com
# 仅指定HTTP诊断路径返回本地403；不整域拒绝，不向源站发送该请求。
0,100,^http:\/\/\w{32}\.jddebug\.com\/diagnose\?,

[MITM]
name = 京东比价
# 两条脚本留在同一MITM规则集，保证共享已捕获的慢慢买凭据。
hostname = in.m.jd.com, apapia-sqk-weblogic.manmanbuy.com
0,100,^https://apapia-sqk-weblogic\.manmanbuy\.com/baoliao/center/menu(?:\?.*)?$,
# 完整响应注入；不使用101分帧脚本或跨请求的临时SKU价表缓存。
1,100,^https://in\.m\.jd\.com/product/graphext/\d+\.html(?:\?.*)?$,
