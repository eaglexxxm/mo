# 51吃瓜广告过滤 v10 · OixCloud Anywhere 原生 .amod
# 网页：首页/分类/文章页去弹窗、浮窗、广告卡片和视频前贴片。
# App：接口脚本不再调用 Anywhere.codec，避免规则 4 编译失败。
# 导入时选择 Anywhere（原生）；停用旧版 51吃瓜 Web/App/合并模块以免重复执行。
[Module]
name = 51吃瓜广告过滤 v10（网页＋App）
description = 修改时间 2026-10-28 13:08。修复脚本规则 4 编译失败，不再读取 Anywhere.codec。开屏、弹窗、浮窗和列表横栏仍由接口字段清空。
icon-light = 
icon-dark = 

[MITM]
name = 51吃瓜广告过滤 v10
hostname = 51cg1.com, www.51cg1.com, p24.airdfpchm.cc, pic.sugfew.cn, bpi5.yrntnqkaq.cc, yrntnqkaq.cc, ofqrumpqf.cc, hkclrsgux.cc, hkjehzjhf.cc
# 51cg1.com HTML 页面：按广告容器和字段清理，域名变化时需更新 MITM 主机范围。
1,100,^https://(?:www\.)?51cg1\.com/(?:(?:category|archives|page|tag|search|author|ai)(?:/[^?#]*)?|[^/?]+\.(?:html?|php))?(?:\?[^#]*)?$,
