# 51吃瓜广告过滤 v16 · OixCloud Anywhere 原生 .amod
# 网页：播放器 data-config 里的广告也清掉，不论属性用单引号还是双引号。
# 书签 App 的广告图域名是 pic.nihmcl.cn，只拦 hc237/uploads/default/other。
# 正文 article.post 保留。接口仍把清理后的 JSON 以文本写回。
# 导入时选择 Anywhere（原生）；停用 v8 到 v15，以及 51cg1屏幕广告.amod。
[Module]
name = 51吃瓜广告过滤 v16（网页＋App）
description = 修改时间 2026-10-28 19:53。补上网页播放器广告，以及书签 App 的新图片域名 pic.nihmcl.cn。
icon-light = 
icon-dark = 

[MITM]
name = 51吃瓜广告过滤 v16
hostname = 51cg1.com, www.51cg1.com, p24.airdfpchm.cc, pic.sugfew.cn, pic.nihmcl.cn, bpi5.yrntnqkaq.cc, yrntnqkaq.cc, ofqrumpqf.cc, hkclrsgux.cc, hkjehzjhf.cc, ddaxhgkn.cc
# HTML：51cg1.com 与书签 App p24.airdfpchm.cc，跳过静态资源和 api.php。
# 网页请求去掉压缩，脚本才能看到 HTML。main.dart.js 和接口不走这条。
0,2,^https://(?:(?:www\.)?51cg1\.com|p24\.airdfpchm\.cc)/(?!api\.php(?:[/?#]|$))(?![^?#]*\.(?:css|js|mjs|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|eot|mp[34]|webm|m3u8|ts|json|xml|txt|wasm|bin|map|data)(?:[?#]|$)).*,Accept-Encoding
1,100,^https://(?:(?:www\.)?51cg1\.com|p24\.airdfpchm\.cc)/(?!api\.php(?:[/?#]|$))(?![^?#]*\.(?:css|js|mjs|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|eot|mp[34]|webm|m3u8|ts|json|xml|txt|wasm|bin|map|data)(?:[?#]|$)).*,
# App：保留流式 Flutter 脚本和签名 API 广告字段处理。
0,2,^https://p24\.airdfpchm\.cc/main\.dart\.js(?:\?.*)?$,Accept-Encoding
1,101,^https://p24\.airdfpchm\.cc/main\.dart\.js(?:\?.*)?$,
# 接口请求去掉压缩，避免脚本看到 gzip 原文后又把清理结果写不回去。
0,2,^https://[^/]+/api\.php/api/(?:home/config|contents/list_contents|contents/detail_content|videos/list_contents|im/ads)/?(?:\?.*)?$,Accept-Encoding
1,100,^https://[^/]+/api\.php/api/(?:home/config|contents/list_contents|contents/detail_content|videos/list_contents|im/ads)/?(?:\?.*)?$,
0,0,^https://pic\.(?:sugfew|nihmcl)\.cn/hc237/uploads/default/other/[^?#]+\.(?:gif|jpe?g|png|webp)(?:\?[^#]*)?$,3
