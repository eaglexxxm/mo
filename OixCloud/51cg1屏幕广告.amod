# 51吃瓜广告过滤 v12 · OixCloud Anywhere 原生 .amod
# 网页：首页/分类/文章页去弹窗、浮窗、广告卡片和视频前贴片。
# App：接口脚本把清理后的 JSON 以文本写回。旧版写成字节数组，活动是绿的，广告仍是原文。
# 导入时选择 Anywhere（原生）；停用 v8 到 v11，以及 51cg1屏幕广告.amod。
[Module]
name = 51吃瓜广告过滤 v12（网页＋App）
description = 修改时间 2026-10-28 15:29。脚本已经命中接口，但清理后的 JSON 没有交回给 App，开屏和弹窗仍是原文。这一版把正文改成文本写回，并去掉接口压缩。
icon-light = 
icon-dark = 

[MITM]
name = 51吃瓜广告过滤 v12
hostname = 51cg1.com, www.51cg1.com, p24.airdfpchm.cc, pic.sugfew.cn, bpi5.yrntnqkaq.cc, yrntnqkaq.cc, ofqrumpqf.cc, hkclrsgux.cc, hkjehzjhf.cc, ddaxhgkn.cc
# 51cg1.com HTML 页面：按广告容器和字段清理，域名变化时需更新 MITM 主机范围。
1,100,^https://(?:www\.)?51cg1\.com/(?:(?:category|archives|page|tag|search|author|ai)(?:/[^?#]*)?|[^/?]+\.(?:html?|php))?(?:\?[^#]*)?$,
# App：保留流式 Flutter 脚本和签名 API 广告字段处理。
0,2,^https://p24\.airdfpchm\.cc/main\.dart\.js(?:\?.*)?$,Accept-Encoding
1,101,^https://p24\.airdfpchm\.cc/main\.dart\.js(?:\?.*)?$,
# 接口请求去掉压缩，避免脚本看到 gzip 原文后又把清理结果写不回去。
0,2,^https://[^/]+/api\.php/api/(?:home/config|contents/list_contents|contents/detail_content|videos/list_contents|im/ads)/?(?:\?.*)?$,Accept-Encoding
1,100,^https://[^/]+/api\.php/api/(?:home/config|contents/list_contents|contents/detail_content|videos/list_contents|im/ads)/?(?:\?.*)?$,
0,0,^https://pic\.sugfew\.cn/hc237/uploads/default/other/[^?#]+\.(?:gif|jpe?g|png|webp)(?:\?[^#]*)?$,3
