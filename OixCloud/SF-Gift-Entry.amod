# 顺丰微信小程序：过滤广告活动素材目录中的图片。
# 原始抓包只确认「送赠送金」位于此目录；「8.8 折签到」未出现在旧 HAR，待新抓包确认。
# 仅处理 ucmp-static.sf-express.com 的广告素材，不改动订单、通卡和支付接口。
[Module]
name = 顺丰·广告悬浮素材 v2
description = 隐藏顺丰广告活动目录的浮动图片，适用于轮换的广告素材。

[MITM]
name = 顺丰广告活动图片
hostname = ucmp-static.sf-express.com
0,0,^https://ucmp-static\.sf-express\.com/sfoss/ad-act/infoflow/[^?#]+\.(?:gif|png|webp|jpe?g)(?:\?.*)?$,3
