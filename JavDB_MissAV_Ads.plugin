#!name=JavDB + MissAV 去广告（脚本）
#!desc=将 QX rewrite_local 改为 Loon Script + MITM + Rule
#!author=ddgksf2013 / converted for Loon

[Script]
# JavDB
http-response ^https?:\/\/javdb\.com\/(?!(.*(api|login|cdn-cgi|verify|auth|captch|(\.(js|css|jpg|jpeg|png|webp|gif|zip|woff|woff2|m3u8|mp4|mov|m4v|avi|mkv|flv|rmvb|wmv|rm|asf|asx|mp3|json|ico|otf|ttf))))) script-path=https://raw.githubusercontent.com/eaglexxxm/mo/refs/heads/r/missav.ads.js, requires-body=true, timeout=30, tag=JavDB去广告

# MissAV（来自脚本注释区）
http-response ^https?:\/\/missav\.(ws|live|com|ai)\/(?!(.*(api|login|cdn-cgi|verify|auth|captch|(\.(js|css|jpg|jpeg|png|webp|gif|zip|woff|woff2|m3u8|mp4|mov|m4v|avi|mkv|flv|rmvb|wmv|rm|asf|asx|mp3|json|ico|otf|ttf))))) script-path=https://raw.githubusercontent.com/eaglexxxm/mo/refs/heads/r/javdb.ads.js, requires-body=true, timeout=30, tag=MissAV去广告

[Rule]
# 你截图里「分流规则」的两条（等价写法）
DOMAIN-SUFFIX,mc.yandex.ru,REJECT
DOMAIN-SUFFIX,static.cloudflareinsights.com,REJECT

[MITM]
hostname = javdb.com, missav.live, missav.ws, missav.ai, missav.com