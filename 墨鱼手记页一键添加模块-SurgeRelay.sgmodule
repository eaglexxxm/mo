#!author=@ddgksf2013 @小白脸 @xream @keywos @ckyb
#!moduleUrl=https://ddgksf2013.top/module/ScriptHub.Surge.sgmodule

# **************************************************************************
# !WARNING: DO NOT EDIT THIS FILE ON DISK DIRECTLY.
# This file is automatically generated by Surge Relay. Any direct edits
# to this file will be overwritten and lost during the next update/sync.
# To customize, please edit via the "Preview" tab inside Surge Relay.
#
# !警告：请勿在磁盘上直接修改此文件。
# 本文件由 Surge Relay 自动生成，直接在此修改的内容将在下一次同步或更新时被覆盖。
# 如需自行修改模块内容，请通过 Surge Relay 右上角的“预览”进行编辑。
# **************************************************************************
[General]
force-http-engine-hosts = %APPEND% script.hub, *.script.hub

[Rule]
AND, ((DOMAIN-SUFFIX, ddgksf2013.top), (PROTOCOL, QUIC)), REJECT-NO-DROP

[Script]
网页变身 = type=http-response, pattern=^https?:\/\/ddgksf2013.top\/$,requires-body=1,max-size=-1,script-path=https://ddgksf2013.top/scripts/web.surge.js, timeout=3500
脚本转换 = type=http-request, pattern=^https?:\/\/script\.hub\/file\/_start_\/.+type=(?:qx-rewrite|surge-module|all-module), script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/Rewrite-Parser.js, timeout=300

[MITM]
hostname = %APPEND% script.hub, *.script.hub, ddgksf2013.top
